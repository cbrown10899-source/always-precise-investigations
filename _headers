# Security headers on every response (Cloudflare Pages reads this file).
# script/style allow 'unsafe-inline' because the pages ship their small
# interactive bits (contact modal, intake form logic) inline; no user input
# is rendered into the DOM. connect-src lists exactly the three endpoints
# the site talks to: the visitor-alerts worker, and the two form relays the
# intake page submits through.
# The trailing "!" line strips the wildcard CORS header Cloudflare Pages adds by
# default, so no other origin can read these pages cross-origin — it matters most
# for /intake and /watch, which are unlisted.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), accelerometer=(), gyroscope=(), magnetometer=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com https://api-visitor-alerts.corlinllc.workers.dev https://api.web3forms.com https://formsubmit.co; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  ! Access-Control-Allow-Origin

# App shell: always revalidate so deploys show up on the next load.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

# Static content routes — safe to cache.
/private-investigator/*
  Cache-Control: public, max-age=3600
/infidelity-investigations/*
  Cache-Control: public, max-age=3600
/child-custody-investigations/*
  Cache-Control: public, max-age=3600
/insurance-investigations/*
  Cache-Control: public, max-age=3600
# The Legal page is an ordinary public content route like the four above it and
# takes the same caching. It was the one sibling without a rule (Unit 37A), so
# it fell through to /* — which carries every security header but sets no
# Cache-Control at all. Nothing about authentication or security changes here:
# the /* block still applies to this path exactly as it did.
/legal-investigations/*
  Cache-Control: public, max-age=3600
/assets/*
  Cache-Control: public, max-age=604800

# Private visitor dashboard — never indexed, never cached.
/watch/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/intake/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow, noarchive
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY

/portal/*
  # private, no-cache — NOT no-store (closeout audit, 2026-09-02). The page
  # holds no user data (every datum arrives from the Worker, which is no-store
  # itself), and it is 1.1 MB: no-store forbade even a conditional request, so
  # every open of the portal re-downloaded 334 KB gzipped with no 304 possible.
  # no-cache still revalidates on every load, so a deploy lands exactly as fast
  # as before; an unchanged shell now costs an empty 304. /watch/* keeps
  # no-store — it holds a token in the page.
  Cache-Control: private, no-cache
  X-Robots-Tag: noindex, nofollow, noarchive
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  # `script-src 'self'` was added 2026-08-18, narrowly and on the owner's
  # approval, for ONE thing: /portal/vendor/mp4-muxer.js, which the video
  # timestamp pipeline imports same-origin. No third-party origin is allowed
  # and no CDN is used — the file is committed in this repo and listed in the
  # deploy allow-list. `worker-src` is deliberately NOT added: the pipeline
  # runs on the main thread, so nothing here needs a worker yet.
  # `img-src` gained `blob:` on 2026-08-19, and it is the same permission
  # `media-src` has carried since the video tool shipped. Timestamp Photo loads
  # the operator's own picture into an <img> from a blob URL made on this page;
  # without `blob:` the browser BLOCKED it and fired `onerror`, which the page
  # faithfully reported as "cannot decode". Every photograph failed, on every
  # device — the file was never the problem. A blob URL is same-origin and
  # opaque to anyone else, which is why `media-src` was already allowed it.
  Content-Security-Policy: default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; manifest-src 'self'; form-action 'none'; frame-ancestors 'none'; base-uri 'none'
